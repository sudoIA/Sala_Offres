rules_version = '2';

// Règles de sécurité Firestore pour Sala.
//
// Principe : le contenu public du site (offres, événements, législation,
// annuaires, réglages) reste lisible par tout le monde comme avant, mais
// seule l'équipe admin (via la collection "roles") peut désormais le
// modifier directement dans la base — jusqu'ici ce contrôle n'existait que
// côté interface (React), donc contournable par n'importe qui appelant
// l'API Firestore directement.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // get()/exists() ici ne redéclenchent pas l'évaluation des règles sur
    // "roles" : c'est le mécanisme standard pour un contrôle de rôle basé
    // sur un document (à défaut de custom claims Firebase Auth).
    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/roles/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role == 'admin';
    }

    // --- Contenu public géré depuis le back-office ---
    match /emplois/{jobId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Nom réel de la collection côté Firestore : "events" (pas "evenements"),
    // partagée avec l'app mobile.
    match /events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /legislation/{ficheId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Questions de quiz (Admin > Quiz), lues par le site et l'app mobile.
    // Schéma contrôlé : un document = une question et 2 à 6 réponses.
    function validQuiz(d) {
      return d.keys().hasOnly(['theme', 'question', 'options', 'order']) &&
        d.theme in ['entretiens', 'droit_du_travail'] &&
        d.question is string && d.question.size() > 0 && d.question.size() <= 500 &&
        d.options is list && d.options.size() >= 2 && d.options.size() <= 6 &&
        d.order is number;
    }

    match /quiz/{questionId} {
      allow read: if true;
      allow create, update: if isAdmin() && validQuiz(request.resource.data);
      allow delete: if isAdmin();
    }

    match /universites/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /entreprises/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /clubs_anglais/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- Offres collectées automatiquement (ACPE, ...), avant validation ---
    // Jamais publique : seule l'équipe admin y accède, depuis l'écran
    // "Imports" du back-office (lecture, écriture ET validation).
    match /emplois_import/{importId} {
      allow read, write: if isAdmin();
    }

    // --- Sources de collecte ajoutées par l'équipe (Admin > Imports) ---
    // Configuration interne (adresses des sites collectés) : admins seulement.
    match /import_sources/{sourceId} {
      allow read, write: if isAdmin();
    }

    // --- Historique des collectes automatiques (tâche planifiée) ---
    // Écrit uniquement par le SDK Admin côté serveur (jamais soumis à ces
    // règles) ; l'équipe admin peut seulement le consulter, pas le modifier.
    match /import_runs/{runId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Chaîne facultative bornée en taille (champ absent accepté).
    function optString(data, key, max) {
      return !(key in data) || (data[key] is string && data[key].size() <= max);
    }

    // --- Inscriptions aux événements ---
    // Formulaire public (pas de compte requis) : on autorise la création
    // d'une inscription avec un schéma restreint, mais seule l'équipe admin
    // peut consulter ou gérer la liste des inscrits (données personnelles).
    // Tailles bornées : un robot ne peut pas y stocker de gros volumes.
    match /inscriptions_evenements/{regId} {
      allow create: if request.resource.data.keys().hasOnly(
          ['eventId', 'eventTitle', 'name', 'email', 'phone', 'registeredAt']
        ) &&
        request.resource.data.eventId is string &&
        request.resource.data.eventId.size() <= 100 &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 120 &&
        optString(request.resource.data, 'eventTitle', 200) &&
        optString(request.resource.data, 'phone', 30) &&
        optString(request.resource.data, 'registeredAt', 40) &&
        (!('email' in request.resource.data) ||
          (request.resource.data.email is string &&
            request.resource.data.email.size() <= 254 &&
            (request.resource.data.email.size() == 0 ||
              request.resource.data.email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$'))));
      allow read, update, delete: if isAdmin();
    }

    // --- Profils candidats ---
    // Chacun ne lit/écrit que son propre profil et ses propres CV ; l'admin
    // peut lister tous les profils (page "Utilisateurs" du back-office).
    //
    // Le profil n'accepte que les champs connus du site, avec des tailles
    // bornées. À la création, tout le document est contrôlé ; à la mise à
    // jour, seuls les champs modifiés (diff), pour ne jamais bloquer un ancien
    // profil qui contiendrait un champ historique.
    function profileKeys() {
      return ['uid', 'fullName', 'email', 'city', 'phone', 'role', 'photoURL', 'bio',
              'skills', 'savedJobs', 'applications', 'jobAlerts', 'createdAt', 'updatedAt'];
    }

    function validProfileValues(d) {
      return optString(d, 'fullName', 120) &&
        optString(d, 'email', 254) &&
        optString(d, 'city', 80) &&
        optString(d, 'phone', 30) &&
        optString(d, 'bio', 2000) &&
        (!('photoURL' in d) || d.photoURL == null || (d.photoURL is string && d.photoURL.size() <= 1000)) &&
        // Le vrai rôle admin vit dans "roles" : ici, seul "candidat" est permis.
        (!('role' in d) || d.role == 'candidat') &&
        (!('skills' in d) || (d.skills is list && d.skills.size() <= 50)) &&
        (!('savedJobs' in d) || (d.savedJobs is list && d.savedJobs.size() <= 500)) &&
        (!('applications' in d) || (d.applications is list && d.applications.size() <= 500)) &&
        (!('jobAlerts' in d) ||
          (d.jobAlerts is map &&
            d.jobAlerts.keys().hasOnly(['enabled', 'keywords', 'city', 'contract']) &&
            d.jobAlerts.enabled is bool &&
            d.jobAlerts.keywords is list && d.jobAlerts.keywords.size() <= 10 &&
            optString(d.jobAlerts, 'city', 80) &&
            optString(d.jobAlerts, 'contract', 40)));
    }

    match /users/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow read: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(profileKeys()) &&
        validProfileValues(request.resource.data);
      allow update: if isSignedIn() && request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(profileKeys()) &&
        validProfileValues(request.resource.data);
      // Suppression de son propre compte (page Profil > Compte).
      allow delete: if isSignedIn() && request.auth.uid == uid;

      // CV enregistrés : écriture réservée aux comptes à l'email vérifié
      // (même exigence que l'interface, mais appliquée par la base).
      match /cvs/{cvId} {
        allow read, delete: if isSignedIn() && request.auth.uid == uid;
        allow create, update: if isSignedIn() && request.auth.uid == uid &&
          request.auth.token.email_verified == true;
      }
    }

    // --- News Sala (page publique /actualites) ---
    // Lecture publique des seuls articles visibles ; l'équipe admin voit et
    // gère tout.
    match /news/{articleId} {
      allow read: if resource.data.visibility == true || isAdmin();
      allow write: if isAdmin();
    }

    // --- Journal des actions admin (Admin > Journal) ---
    // Ajout uniquement, par un admin et à son propre nom ; jamais modifié ni
    // supprimé, pour que l'historique reste fiable.
    match /admin_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.keys().hasOnly(['action', 'target', 'label', 'targetId', 'uid', 'email', 'at']) &&
        request.resource.data.label is string && request.resource.data.label.size() <= 200;
      allow update, delete: if false;
    }

    // --- Erreurs rencontrées par les visiteurs ---
    // Écrites uniquement par le serveur (SDK Admin, route /api/client-errors).
    match /client_errors/{errorId} {
      allow read, delete: if isAdmin();
      allow create, update: if false;
    }

    // --- Compteur de consultations des offres (anonyme) ---
    // Un visiteur peut seulement ajouter 1 ; seuls les admins lisent les
    // chiffres (tableau de bord).
    match /job_views/{jobId} {
      allow read: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['count']) &&
        request.resource.data.count == 1;
      allow update: if request.resource.data.keys().hasOnly(['count']) &&
        request.resource.data.count == resource.data.count + 1;
      allow delete: if isAdmin();
    }

    // --- Rôles admin ---
    // Chacun peut savoir s'il est admin lui-même ; seule l'équipe admin peut
    // lister tous les rôles ou en attribuer/retirer.
    match /roles/{uid} {
      allow get: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // --- Application mobile ---
    // Ce projet Firebase est partagé avec l'app mobile : ces règles doivent
    // rester ici, sinon une publication depuis le site les écraserait (et
    // inversement, une publication depuis l'app mobile a déjà écrasé celles
    // du site le 2 octobre 2026). Toujours fusionner, jamais remplacer.

    // Questions d'entretien : lisibles une fois connecté.
    match /Questions/{questionId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Réponses et profils de l'app : chacun ne lit/écrit que les siens.
    match /Reponse/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /utilisateurs/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /droit_du_travail/{docId} {
      allow read: if true;
    }

    // Publicités (nom des collections conservé tel quel, y compris
    // "InterstialAds", pour correspondre à la base).
    match /NativeAds/{docId} {
      allow read: if true;
    }

    match /InterstialAds/{docId} {
      allow read: if true;
    }

    match /BannerAds/{docId} {
      allow read: if true;
    }

    // Tout le reste est refusé par défaut.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
