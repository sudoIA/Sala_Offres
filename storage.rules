rules_version = '2';

// Le site Next.js n'uploade rien lui-même vers Firebase Storage, mais
// l'application mobile Android du même projet Firebase (voir l'appId dans
// src/lib/firebase.ts) y héberge des images affichées publiquement (ex :
// logos, visuels) — un verrouillage total en lecture les rend invisibles
// partout, y compris sur mobile. On rouvre donc la lecture au public, tout
// en réservant l'écriture à l'équipe admin (même logique que Firestore).
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null &&
        firestore.exists(/databases/(default)/documents/roles/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/roles/$(request.auth.uid)).data.role == 'admin';
    }

    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
